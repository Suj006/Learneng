# ── Database ───────────────────────────────────────────────────────────────
# Leave empty for local development: PING VIBE runs an embedded PostgreSQL
# (PGlite) persisted to ./.data/pingvibe. For production set a Postgres URL
# (e.g. the Supabase "Session pooler" connection string).
DATABASE_URL=
# Connections per server instance when DATABASE_URL is set (default 5).
DB_POOL_MAX=

# ── Security ───────────────────────────────────────────────────────────────
# 32+ random characters. Used to sign session cookies and tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL used in verification e-mails.
APP_URL=http://localhost:3000

# ── AI (Claude) ────────────────────────────────────────────────────────────
# Server-side only. When unset, PING VIBE uses its built-in offline writing
# evaluator and dictionary-based companion (clearly labelled in the UI).
ANTHROPIC_API_KEY=
# Alternative name for hosts that reserve ANTHROPIC_API_KEY (e.g. Claude Code cloud environments). Takes precedence when set.
PINGVIBE_ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── E-mail ─────────────────────────────────────────────────────────────────
# When RESEND_API_KEY is set, verification mails are sent via Resend.
# Otherwise (development only) the link is written to the server log and to
# the developer mailbox page at /dev/mailbox.
RESEND_API_KEY=
EMAIL_FROM="PING VIBE <hello@pingvibe.app>"

# ── Admin bootstrap ────────────────────────────────────────────────────────
# Used by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL=admin@pingvibe.local
ADMIN_PASSWORD=ChangeMe!2026

# ── Scheduling ─────────────────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/*.
CRON_SECRET=
# Day boundaries for quests, streaks and caps.
APP_TIMEZONE=Asia/Kolkata

# ── QA / staging only ──────────────────────────────────────────────────────
# Store e-mails in /dev/mailbox even in a production build (never set in real production).
EMAIL_TRANSPORT=
# Raise network-wide rate limits when all test clients share one IP (never set in production).
IP_RATE_LIMIT_MULTIPLIER=
